# Environment Variables Configuration
# Copy this file to .env.local for local development

# Base URL for the application
# This is used for generating absolute URLs in metadata (Open Graph, Twitter cards, etc.)
#
# For local development:
NEXT_PUBLIC_BASE_URL=http://localhost:3000
#
# For Vercel deployment, set this in Vercel Dashboard > Settings > Environment Variables:
# Production: NEXT_PUBLIC_BASE_URL=https://enigma-ai.co
# Preview: NEXT_PUBLIC_BASE_URL=https://landing-page-1znb.vercel.app
#
# After adding the variable in Vercel, redeploy your site for changes to take effect.
